# ---------------------------------------------------------------------------
# Modo de login: "qr" desenha o QR code no terminal, "pairing" pede um codigo
# de 8 digitos para digitar no celular (util em servidor sem tela).
# ---------------------------------------------------------------------------
LOGIN_MODE=qr

# Somente para LOGIN_MODE=pairing. Seu numero no formato internacional, sem "+".
# Exemplo: 5517999999999
PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Metadados que aparecem na figurinha
# ---------------------------------------------------------------------------
PACK_NAME=Minhas Figurinhas
PACK_AUTHOR=Mateus

# ---------------------------------------------------------------------------
# Contatos autorizados alem do self-chat.
# Lista separada por virgula, formato internacional sem "+". Deixe vazio para
# que o bot atenda somente voce.
# Exemplo: ALLOWED_NUMBERS=5517999999999,5517888888888
# ---------------------------------------------------------------------------
ALLOWED_NUMBERS=

# ---------------------------------------------------------------------------
# Limites de conversao
# ---------------------------------------------------------------------------
MAX_VIDEO_SECONDS=8
MAX_INPUT_MB=20

# Prefixo dos comandos. Com "!" os comandos sao !s, !sc e !help.
COMMAND_PREFIX=!

# ---------------------------------------------------------------------------
# Anti-abuso: maximo de comandos por minuto por conversa, incluindo o self-chat.
# Ao exceder, o bot ignora em silencio.
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MIN=10

# Ignora mensagens anteriores ao inicio do processo. Mantenha "true": evita que
# um "!s" antigo dispare em rajada quando o bot reconecta.
IGNORE_OLD_MESSAGES=true

# trace | debug | info | warn | error
LOG_LEVEL=info

# Caminho do binario do ffmpeg. Deixe "ffmpeg" quando ele ja estiver no PATH.
# No Windows, um caminho completo seria algo como:
# FFMPEG_PATH=C:/ProgramData/chocolatey/bin/ffmpeg.exe
FFMPEG_PATH=ffmpeg
